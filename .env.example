# JARVIS X local configuration
JARVIS_ENV=development
JARVIS_LOG_LEVEL=INFO
JARVIS_DATA_DIR=data
JARVIS_LOG_DIR=logs
JARVIS_PRIMARY_PROVIDER=agentrouter
JARVIS_ALLOW_PAID_PROVIDERS=false

# Phase 2C.1 primary provider. Keep secrets local.
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=gpt-6.1-sol
AGENTROUTER_BILLING_MODE=unknown
# Set only after checking the AgentRouter dashboard immediately before a live test.
AGENTROUTER_PREPAID_BALANCE_STATUS=unknown
AGENTROUTER_AUTO_RECHARGE_STATUS=unknown
AGENTROUTER_MODELS_ENDPOINT_SUPPORTED=false

# Phase 2C.1 verified-free fallback provider.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=
# Set true only after confirming the exact model above is currently in Free Tier.
GEMINI_FREE_TIER_VERIFIED=false
GEMINI_FREE_TIER_VERIFIED_MODEL=
